# Default (no setup needed): SQLite file, created automatically.
# DATABASE_URL=sqlite:///./spendwise.db

# PostgreSQL: create an empty database named "spendwise" first, then uncomment and edit:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/spendwise

SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
